#!/usr/bin/env sh
set -eu

HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
staged=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(py|pyi|js|jsx|ts|tsx|mjs|mts)$' || true)

if [ -n "$staged" ]; then
  printf '%s\n' "$staged" | tr '\n' '\0' | xargs -0 "$HOOK_DIR/../bin/lints" lint
fi
