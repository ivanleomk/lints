#!/usr/bin/env sh
set -eu

src=$0
while [ -L "$src" ]; do
  dir=$(CDPATH= cd -- "$(dirname -- "$src")" && pwd -P)
  target=$(readlink "$src")
  case $target in
    /*) src=$target ;;
    *) src="$dir/$target" ;;
  esac
done
HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$src")" && pwd -P)

set -- ':(top)*.py' ':(top)*.pyi' ':(top)*.js' ':(top)*.jsx' ':(top)*.ts' ':(top)*.tsx' ':(top)*.mjs' ':(top)*.mts'
if ! git diff --cached --quiet --diff-filter=ACMR -- "$@"; then
  cd "$(git rev-parse --show-toplevel)"
  git diff --cached --name-only -z --diff-filter=ACMR -- "$@" | xargs -0 "$HOOK_DIR/../bin/lints" lint
fi
