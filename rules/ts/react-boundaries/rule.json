{
  "summary": "Enforce React Rules of Hooks and keep `.tsx`/`.jsx` exports component-pure.",
  "oxlint": {
    "plugins": ["react"],
    "rules": {
      "react/rules-of-hooks": "error"
    },
    "overrides": [
      {
        "files": ["**/*.tsx", "**/*.jsx"],
        "rules": {
          "react/only-export-components": ["error", { "allowConstantExport": true }]
        }
      }
    ]
  }
}
